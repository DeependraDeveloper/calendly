// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  slug      String?  @unique
  timezone  String   @default("UTC")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventTypes             EventType[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  slots                  Slot[]
  bookings               Booking[]

  @@map("users")
}

// booking event
// A user has many event types, and an event type belongs to a user (the host).
model EventType {
  id                  Int      @id @default(autoincrement())
  hostId              Int
  title               String
  description         String?
  slug                String
  durationMinutes     Int
  isActive            Boolean  @default(true)
  locationType        String   @default("online")
  locationValue       String? // meeting link or any address
  bufferBeforeMinutes Int?     @default(0) // break time before the event starts
  bufferAfterMinutes  Int?     @default(0) // break time after the event ends
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  host                User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  slots    Slot[]
  bookings Booking[]

  @@unique([hostId, slug])
  @@map("event_types")
}

// cascade delete: when a user is deleted, all their event types will also be deleted. This is achieved by the `onDelete: Cascade` option in the relation definition between `User` and `EventType`.

model AvailabilityRule {
  id        Int      @id @default(autoincrement())
  userId    Int
  weekday   Int
  startTime String
  endTime   String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday])
  @@map("availibility_rules")
}

model AvailabilityException {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  type      String
  startTime String?
  endTime   String?
  reason    String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("availibility_exceptions")
}

model Slot {
  id          Int      @id @default(autoincrement())
  hostId      Int
  eventTypeId Int
  startAt     DateTime
  endAt       DateTime
  status      String   @default("AVAILABLE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@unique([eventTypeId, startAt, endAt])
  @@index([hostId, startAt])
  @@index([eventTypeId, startAt, status])
  @@map("slots")
}

model Booking {
  id              Int       @id @default(autoincrement())
  hostId          Int
  eventType       Int
  slotId          Int
  inviteeEmail    String
  inviteeNotes    String
  inviteeName     String
  status          String    @default("PENDING")
  meetingLink     String?
  calendarEventId String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  evenType EventType @relation(fields: [eventType], references: [id], onDelete: Cascade)
  slot     Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([inviteeEmail])
  @@index([hostId, createdAt])
  @@map("bookings")
}
