{
  "name": "calendly",
  "version": "1.0.0",
  "description": "Calendly makes scheduling simple",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "dev:worker": "nodemon --watch src --ext ts --exec 'tsx src/temporal/worker.ts'",
    "start": "node dist/server.js",
    "build": "tsc",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:all": "npm run prisma:format && npm run prisma:migrate && npm run prisma:generate",
    "prisma:studio": "npx prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@temporalio/activity": "^1.20.2",
    "@temporalio/client": "^1.20.2",
    "@temporalio/worker": "^1.20.2",
    "@temporalio/workflow": "^1.20.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "slug": "^11.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/slug": "^5.0.9",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "@swc/core@1.15.43": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "protobufjs@7.6.5": true
  }
}
